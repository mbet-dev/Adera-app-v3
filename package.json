{
  "name": "adera-hybrid-app",
  "version": "1.0.0",
  "private": true,
  "description": "Adera Hybrid App - Logistics (PTP) and E-Commerce (Shop) platform for Addis Ababa",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run dev --workspace=apps/adera-ptp",
    "start": "npm run start --workspace=apps/adera-ptp",
    "web": "npm run web --workspace=apps/adera-ptp",
    "android": "npm run android --workspace=apps/adera-ptp",
    "ios": "npm run ios --workspace=apps/adera-ptp",
    "clear": "npm run clear --workspace=apps/adera-ptp",
    "dev:shop": "npm run dev --workspace=apps/adera-shop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{apps,packages,supabase}/**/*.{js,jsx,json,md}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"{apps,packages,supabase}/**/*.{js,jsx,json,md}\" \"*.{js,json,md}\"",
    "audit:security": "npm audit --audit-level=high",
    "test": "jest",
    "clean": "turbo run clean",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^20.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.3.0",
    "turbo": "^2.5.8",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@sentry/react-native": "^8.28.0",
    "expo-constants": "^18.0.10",
    "expo-modules-core": "^3.0.25",
    "react-native-svg": "^15.15.5",
    "zustand": "4.5.2"
  }
}
