[TEMPLATE]
# Adera-Shop Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: Supabase Dashboard > Project Settings > API
# Uses the SAME Supabase project as Adera-PTP
EXPO_PUBLIC_SUPABASE_URL=https://ehrmscvjuxnqpxcixnvq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service role key (KEEP SECRET - server-side only)
# Only use in Supabase Edge Functions, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# PAYMENT GATEWAYS
# ============================================

# TeleBirr Configuration
# Get credentials from: https://developer.ethiotelecom.et/
EXPO_PUBLIC_TELEBIRR_APP_ID="Bearer your-telebirr-app-id"
EXPO_PUBLIC_TELEBIRR_APP_KEY=your-telebirr-app-key
EXPO_PUBLIC_TELEBIRR_PUBLIC_KEY=your-telebirr-public-key
EXPO_PUBLIC_TELEBIRR_SHORT_CODE=your-short-code
TELEBIRR_PRIVATE_KEY=your-telebirr-private-key
EXPO_PUBLIC_TELEBIRR_CALLBACK_URL=https://your-domain.com/api/telebirr/callback

# Chapa Configuration
# Get credentials from: https://dashboard.chapa.co/
EXPO_PUBLIC_CHAPA_PUBLIC_KEY=your-chapa-public-key
CHAPA_SECRET_KEY=your-chapa-secret-key
EXPO_PUBLIC_CHAPA_CALLBACK_URL=https://your-domain.com/api/chapa/callback

# ArifPay Configuration (Optional)
# Get credentials from: https://developer.arifpay.net/
EXPO_PUBLIC_ARIFPAY_API_KEY=your-arifpay-api-key
ARIFPAY_SECRET_KEY=your-arifpay-secret-key
EXPO_PUBLIC_ARIFPAY_CALLBACK_URL=https://your-domain.com/api/arifpay/callback

# ============================================
# SMS & NOTIFICATIONS
# ============================================

# Twilio Configuration (for order confirmation SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Ethiopian SMS Gateway (when available)
ETHIOPIAN_SMS_API_URL=https://sms-gateway.et/api/send
ETHIOPIAN_SMS_API_KEY=your-sms-api-key
ETHIOPIAN_SMS_SENDER_ID=ADERA

# Firebase Cloud Messaging (FCM)
EXPO_PUBLIC_FCM_SERVER_KEY=your-fcm-server-key
EXPO_PUBLIC_FCM_SENDER_ID=your-fcm-sender-id

# ============================================
# EMAIL CONFIGURATION (for order confirmations)
# ============================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@adera.et
SMTP_FROM_NAME=Adera Shop

# ============================================
# APP CONFIGURATION
# ============================================

EXPO_PUBLIC_APP_ENV=development
# Options: development, staging, production

EXPO_PUBLIC_API_BASE_URL=https://api.adera.et
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_GUEST_MODE=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_DARK_MODE=false

# ============================================
# BUSINESS CONFIGURATION
# ============================================

# Shop Commission Rate (4% split 2% buyer + 2% seller)
EXPO_PUBLIC_SHOP_COMMISSION_RATE=0.04

# Delivery Configuration
EXPO_PUBLIC_STANDARD_DELIVERY_FEE=150.00
EXPO_PUBLIC_PTP_DELIVERY_FEE=250.00

# ============================================
# DEVELOPMENT TOOLS
# ============================================

EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_MOCK_PAYMENTS=false

# ============================================
# NOTES
# ============================================
# 1. NEVER commit .env.local to version control
# 2. Keep all SECRET keys secure and rotate them regularly
# 3. Use different values for development, staging, and production
# 4. EXPO_PUBLIC_ prefix makes variables available to client-side code
# 5. Variables without EXPO_PUBLIC_ are server-side only
# 6. This app shares Supabase with Adera-PTP
#
