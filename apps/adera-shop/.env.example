# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# ── Supabase (required) ─────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Chapa Payment Gateway (required for payments) ───────────────
# Get keys at https://dashboard.chapa.co → Settings → API
# The secret key must be kept server-side (Supabase Edge Function) in production.
EXPO_PUBLIC_CHAPA_PUBLIC_KEY=

# ── Sentry Error Tracking (optional but recommended) ────────────
# Create a project at https://sentry.io, then paste the client DSN.
# Leave empty to disable Sentry entirely (all calls become no-ops).
EXPO_PUBLIC_SENTRY_DSN=
