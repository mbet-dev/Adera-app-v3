{
  "expo": {
    "name": "Adera Shop",
    "slug": "adera-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "scheme": "adera-shop",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adera.shop",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required to scan product QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.adera.shop",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Adera Shop to access your camera for QR code scanning."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Adera Shop to use your location for delivery."
        }
      ]
    ]
  }
}
